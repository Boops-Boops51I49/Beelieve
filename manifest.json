{
  "manifest_version": 2,
  "name": "Focus Freeze",
  "version": "1.0",
  "description": "Freezes distracting websites and forces intentional choice.",
  "permissions": [
    "tabs",
    "storage",
    "*://*.youtube.com/*",
    "*://*.reddit.com/*",
    "*://*.instagram.com/*",
    "*://*.x.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
  "default_popup": "popup.html",
  "default_title": "Saved Links"
},
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.reddit.com/*",
        "*://*.instagram.com/*",
        "*://*.x.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
